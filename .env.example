# Turso DB credentials. The app auto-discovers ANY env var whose name contains
# TURSO + DATABASE_URL / AUTH_TOKEN, e.g.:
#   TURSO_DATABASE_URL / TURSO_AUTH_TOKEN            (Vercel Turso integration style)
#   MENTAL_TURSO_DATABASE_URL / MENTAL_TURSO_AUTH_TOKEN
# Shortest (canonical) names win; placeholder tokens like "dummytoken" are skipped.
MENTAL_TURSO_DATABASE_URL=libsql://your-db.turso.io
MENTAL_TURSO_AUTH_TOKEN=your-jwt-token
# Secret for signing session JWTs (dev fallback: random per boot)
JWT_SECRET=change-me
PORT=3000
